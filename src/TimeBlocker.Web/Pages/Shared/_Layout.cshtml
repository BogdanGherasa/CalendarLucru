<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"] is string title ? $"{title} – Time-Blocker" : "Time-Blocker")</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand bg-body-tertiary border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-page="/Index">Time-Blocker</a>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <span class="navbar-text small text-truncate user-email" title="@User.Identity?.Name">@User.Identity?.Name</span>
                        <form method="post" asp-page="/Account/Logout" class="m-0">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Deconectare</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-link btn-sm" asp-page="/Account/Login">Autentificare</a>
                        <a class="btn btn-primary btn-sm" asp-page="/Account/Register">Înregistrare</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="@(ViewData["MainClass"] as string ?? "container py-4")">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
